generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserRoleStatus {
  ACTIVE
  PENDING_PROFILE
  INACTIVE
}

enum Visibility {
  PUBLIC
  REGISTERED_ONLY
  PRIVATE
}

enum ProfileStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SUSPENDED
  HIDDEN
}

enum VenueValidationStatus {
  PENDING_VALIDATION
  VALIDATED
  REJECTED
  SUSPENDED
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
}

enum BandStatus {
  ACTIVE
  INACTIVE
  DISBANDED
}

enum BandMemberRole {
  ADMIN
  MEMBER
  REPRESENTATIVE
}

enum BandMemberStatus {
  ACTIVE
  INACTIVE
}

enum BandInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum PortfolioItemType {
  IMAGE
  VIDEO
  AUDIO
  LINK
  DOCUMENT
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

enum MemberSearchStatus {
  OPEN
  PAUSED
  CLOSED
  CANCELLED
}

enum MemberSearchApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum RecommendationDecision {
  INTERESTED
  DISMISSED
}

enum SearchModality {
  IN_PERSON
  REMOTE
  HYBRID
}

enum ContactTargetType {
  MUSICIAN
  BAND_PROJECT
}

enum ContactIntentSource {
  SEARCH_RESULT
  RECOMMENDATION
  APPLICATION
}

enum ContactIntentStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum EventParticipantRole {
  ORGANIZER
  PERFORMER
  VENUE
  PROVIDER
  CREW
  GUEST
}

enum ParticipationStatus {
  INVITED
  CONFIRMED
  DECLINED
  CANCELLED
}

enum CallStatus {
  OPEN
  IN_REVIEW
  CLOSED
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  PRESELECTED
  SELECTED
  REJECTED
  CANCELLED
  WITHDRAWN
}

enum CallConfirmationStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  DECLINED
}

enum CallApplicantType {
  MUSICIAN
  BAND_PROJECT
}

enum CallOrganizerType {
  USER
  MUSICIAN
  BAND_PROJECT
  VENUE
  PRODUCER
}

enum CallType {
  VENUE_DATE
  FESTIVAL
  SUPPORT_BAND
  PRIVATE_EVENT
  COLLABORATION
  OTHER
}

enum RehearsalStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum RehearsalParticipantStatus {
  INVITED
  CONFIRMED
  DECLINED
  ATTENDED
  ABSENT
}

enum ConversationType {
  DIRECT
  GROUP
  BAND
  EVENT
  CALL
  MARKETPLACE
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  CLOSED
}

enum MarketplacePostType {
  SALE
  RENTAL
  SERVICE
}

enum MarketplaceStatus {
  PUBLISHED
  RESERVED
  SOLD
  CANCELLED
  SUSPENDED
}

enum MarketplaceOperationType {
  PURCHASE
  RENTAL
  SERVICE_BOOKING
}

enum MarketplaceOperationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ReportType {
  SPAM
  ABUSE
  FRAUD
  INAPPROPRIATE_CONTENT
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  REGISTER
  ROLE_ACTIVATE
  ROLE_DEACTIVATE
  PREFERENCES_UPDATE
  STATUS_CHANGE
}

model User {
  id                          String                           @id @default(uuid()) @db.Uuid
  email                       String                           @unique
  passwordHash                String?
  firstName                   String
  lastName                    String
  locationText                String?
  status                      UserStatus                       @default(ACTIVE)
  termsAcceptedAt             DateTime?
  emailVerifiedAt             DateTime?
  lastLoginAt                 DateTime?
  createdAt                   DateTime                         @default(now())
  updatedAt                   DateTime                         @updatedAt
  deletedAt                   DateTime?
  roles                       UserRole[]
  preferences                 UserPreferences?
  musicianProfile             MusicianProfile?
  venueMemberships            VenueMember[]
  providerMemberships         ProviderMember[]
  ownedVenues                 VenueProfile[]                   @relation("VenueOwner")
  ownedProviders              ProviderProfile[]                @relation("ProviderOwner")
  ownedBands                  BandProject[]                    @relation("BandOwner")
  bandMemberships             BandMember[]
  bandInvitationsSent         BandInvitation[]                 @relation("BandInvitationSender")
  bandInvitationsReceived     BandInvitation[]                 @relation("BandInvitationRecipient")
  organizedEvents             Event[]                          @relation("EventOrganizer")
  eventParticipations         EventParticipant[]
  createdCalls                Call[]                           @relation("CallCreator")
  submittedApplications       Application[]                    @relation("ApplicationSubmitter")
  callConfirmations           CallConfirmation[]
  callStatusChanges           CallStatusHistory[]
  organizedRehearsals         Rehearsal[]                      @relation("RehearsalOrganizer")
  rehearsalParticipations     RehearsalParticipant[]
  createdConversations        ChatConversation[]               @relation("ConversationCreator")
  conversationParticipants    ChatParticipant[]
  sentMessages                ChatMessage[]
  marketplacePosts            MarketplacePost[]
  marketplaceOperationsBought MarketplaceOperation[]           @relation("MarketplaceBuyer")
  marketplaceOperationsSold   MarketplaceOperation[]           @relation("MarketplaceSeller")
  ratingsAuthored             Rating[]                         @relation("RatingAuthor")
  reportsFiled                Report[]                         @relation("ReportReporter")
  reportsReceived             Report[]                         @relation("ReportedUser")
  reportsAssigned             Report[]                         @relation("ReportAssignee")
  auditLogs                   AuditLog[]                       @relation("AuditActor")
  portfolioItemsCreated       PortfolioItem[]                  @relation("PortfolioCreator")
  portfolioSharesCreated      PortfolioItemShare[]             @relation("PortfolioShareCreator")
  memberSearchesCreated       MemberSearch[]                   @relation("MemberSearchCreator")
  recommendationDecisions     MusicianRecommendationDecision[]
  contactIntentsRequested     ContactIntent[]                  @relation("ContactIntentRequester")
  contactIntentsReceived      ContactIntent[]                  @relation("ContactIntentTarget")

  @@index([status])
  @@index([deletedAt])
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       UserRole[]
}

model UserRole {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  roleId        String         @db.Uuid
  status        UserRoleStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deactivatedAt DateTime?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId, status])
  @@index([roleId])
}

model UserPreferences {
  id                           String     @id @default(uuid()) @db.Uuid
  userId                       String     @unique @db.Uuid
  locale                       String     @default("es-AR")
  timezone                     String     @default("America/Argentina/Buenos_Aires")
  internalNotificationsEnabled Boolean    @default(true)
  pushNotificationsEnabled     Boolean    @default(true)
  emailNotificationsEnabled    Boolean    @default(true)
  defaultVisibility            Visibility @default(REGISTERED_ONLY)
  contactAvailability          Boolean    @default(true)
  createdAt                    DateTime   @default(now())
  updatedAt                    DateTime   @updatedAt
  user                         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MusicianProfile {
  id                       String                           @id @default(uuid()) @db.Uuid
  userId                   String                           @unique @db.Uuid
  stageName                String?
  bio                      String?
  instruments              String[]
  genres                   String[]
  influences               String[]
  experience               String?
  experienceLevel          ExperienceLevel?
  previousProjects         String[]
  availableForProjects     Boolean                          @default(false)
  isSoloProject            Boolean                          @default(true)
  locationText             String?
  city                     String?
  countryCode              String?                          @db.Char(2)
  photoUrl                 String?
  visibility               Visibility                       @default(PUBLIC)
  locationVisibility       Visibility                       @default(REGISTERED_ONLY)
  status                   ProfileStatus                    @default(DRAFT)
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  deletedAt                DateTime?
  user                     User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  links                    ProfileLink[]
  portfolioItems           PortfolioItem[]
  portfolioShares          PortfolioItemShare[]
  applications             Application[]
  organizedCalls           Call[]
  ratings                  Rating[]
  memberSearches           MemberSearch[]
  memberSearchApplications MemberSearchApplication[]
  recommendationTargets    MusicianRecommendationDecision[]

  @@index([visibility, status])
  @@index([experienceLevel])
  @@index([deletedAt])
}

model VenueProfile {
  id                  String                @id @default(uuid()) @db.Uuid
  ownerUserId         String                @db.Uuid
  locationId          String?               @db.Uuid
  name                String
  description         String?
  capacity            Int?
  genres              String[]
  availability        Json?
  equipment           String[]
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  contactVisibility   Visibility            @default(PRIVATE)
  addressVisibility   Visibility            @default(PUBLIC)
  visibility          Visibility            @default(PUBLIC)
  status              ProfileStatus         @default(DRAFT)
  validationStatus    VenueValidationStatus @default(PENDING_VALIDATION)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?
  location            Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  owner               User                  @relation("VenueOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members             VenueMember[]
  links               ProfileLink[]
  events              Event[]
  calls               Call[]
  rehearsals          Rehearsal[]
  eventParticipations EventParticipant[]
  ratings             Rating[]

  @@index([ownerUserId])
  @@index([locationId])
  @@index([visibility, status])
  @@index([deletedAt])
}

model VenueMember {
  id        String                 @id @default(uuid()) @db.Uuid
  venueId   String                 @db.Uuid
  userId    String                 @db.Uuid
  role      OrganizationMemberRole @default(ADMIN)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  venue     VenueProfile           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId])
  @@index([userId])
}

model ProviderProfile {
  id                  String             @id @default(uuid()) @db.Uuid
  ownerUserId         String             @db.Uuid
  locationId          String?            @db.Uuid
  businessName        String
  description         String?
  serviceTags         String[]
  coverageArea        String?
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  contactVisibility   Visibility         @default(PRIVATE)
  addressVisibility   Visibility         @default(REGISTERED_ONLY)
  visibility          Visibility         @default(PUBLIC)
  status              ProfileStatus      @default(DRAFT)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  location            Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  owner               User               @relation("ProviderOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members             ProviderMember[]
  links               ProfileLink[]
  eventParticipations EventParticipant[]
  ratings             Rating[]

  @@index([ownerUserId])
  @@index([locationId])
  @@index([visibility, status])
  @@index([deletedAt])
}

model ProviderMember {
  id         String                 @id @default(uuid()) @db.Uuid
  providerId String                 @db.Uuid
  userId     String                 @db.Uuid
  role       OrganizationMemberRole @default(ADMIN)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  provider   ProviderProfile        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, userId])
  @@index([userId])
}

model Location {
  id               String            @id @default(uuid()) @db.Uuid
  name             String?
  addressLine1     String
  addressLine2     String?
  city             String
  region           String?
  postalCode       String?
  countryCode      String            @db.Char(2)
  latitude         Decimal?          @db.Decimal(9, 6)
  longitude        Decimal?          @db.Decimal(9, 6)
  timezone         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  venues           VenueProfile[]
  providers        ProviderProfile[]
  events           Event[]
  rehearsals       Rehearsal[]
  marketplacePosts MarketplacePost[]

  @@index([city, countryCode])
  @@index([deletedAt])
}

model BandProject {
  id                     String                           @id @default(uuid()) @db.Uuid
  ownerUserId            String                           @db.Uuid
  name                   String
  description            String?
  genres                 String[]
  influences             String[]
  locationText           String?
  city                   String?
  countryCode            String?                          @db.Char(2)
  imageUrl               String?
  locationVisibility     Visibility                       @default(REGISTERED_ONLY)
  visibility             Visibility                       @default(PUBLIC)
  status                 BandStatus                       @default(ACTIVE)
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  deletedAt              DateTime?
  owner                  User                             @relation("BandOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members                BandMember[]
  invitations            BandInvitation[]
  links                  ProfileLink[]
  portfolioItems         PortfolioItem[]
  events                 EventParticipant[]
  calls                  Call[]
  applications           Application[]
  rehearsals             Rehearsal[]
  conversations          ChatConversation[]
  ratings                Rating[]
  memberSearches         MemberSearch[]
  recommendationContexts MusicianRecommendationDecision[]

  @@index([ownerUserId])
  @@index([visibility, status])
  @@index([deletedAt])
}

model BandMember {
  id         String           @id @default(uuid()) @db.Uuid
  bandId     String           @db.Uuid
  userId     String           @db.Uuid
  role       BandMemberRole   @default(MEMBER)
  status     BandMemberStatus @default(ACTIVE)
  instrument String?
  joinedAt   DateTime         @default(now())
  leftAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  band       BandProject      @relation(fields: [bandId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bandId, userId])
  @@index([userId, status])
}

model BandInvitation {
  id            String               @id @default(uuid()) @db.Uuid
  bandId        String               @db.Uuid
  invitedUserId String?              @db.Uuid
  invitedEmail  String?
  invitedById   String               @db.Uuid
  role          BandMemberRole       @default(MEMBER)
  instrument    String?
  message       String?
  status        BandInvitationStatus @default(PENDING)
  expiresAt     DateTime?
  respondedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  band          BandProject          @relation(fields: [bandId], references: [id], onDelete: Cascade)
  invitedUser   User?                @relation("BandInvitationRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy     User                 @relation("BandInvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([bandId, status])
  @@index([invitedUserId, status])
}

model ProfileLink {
  id                String           @id @default(uuid()) @db.Uuid
  musicianProfileId String?          @db.Uuid
  venueProfileId    String?          @db.Uuid
  providerProfileId String?          @db.Uuid
  bandProjectId     String?          @db.Uuid
  label             String
  url               String
  visibility        Visibility       @default(PUBLIC)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  musicianProfile   MusicianProfile? @relation(fields: [musicianProfileId], references: [id], onDelete: Cascade)
  venueProfile      VenueProfile?    @relation(fields: [venueProfileId], references: [id], onDelete: Cascade)
  providerProfile   ProviderProfile? @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  bandProject       BandProject?     @relation(fields: [bandProjectId], references: [id], onDelete: Cascade)

  @@index([musicianProfileId])
  @@index([venueProfileId])
  @@index([providerProfileId])
  @@index([bandProjectId])
}

model PortfolioItem {
  id                String               @id @default(uuid()) @db.Uuid
  createdByUserId   String               @db.Uuid
  musicianProfileId String?              @db.Uuid
  bandProjectId     String?              @db.Uuid
  type              PortfolioItemType
  title             String
  description       String?
  url               String
  storageKey        String?
  mimeType          String?
  experienceRef     String?
  visibility        Visibility           @default(PUBLIC)
  sortOrder         Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  createdBy         User                 @relation("PortfolioCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  musicianProfile   MusicianProfile?     @relation(fields: [musicianProfileId], references: [id], onDelete: Cascade)
  bandProject       BandProject?         @relation(fields: [bandProjectId], references: [id], onDelete: Cascade)
  shares            PortfolioItemShare[]

  @@index([musicianProfileId, sortOrder])
  @@index([bandProjectId, sortOrder])
  @@index([visibility, deletedAt])
}

model PortfolioItemShare {
  id                String          @id @default(uuid()) @db.Uuid
  portfolioItemId   String          @db.Uuid
  musicianProfileId String          @db.Uuid
  createdByUserId   String          @db.Uuid
  createdAt         DateTime        @default(now())
  portfolioItem     PortfolioItem   @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  musicianProfile   MusicianProfile @relation(fields: [musicianProfileId], references: [id], onDelete: Cascade)
  createdBy         User            @relation("PortfolioShareCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@unique([portfolioItemId, musicianProfileId])
  @@index([musicianProfileId])
}

model MemberSearch {
  id                   String                    @id @default(uuid()) @db.Uuid
  creatorUserId        String                    @db.Uuid
  musicianProfileId    String?                   @db.Uuid
  bandProjectId        String?                   @db.Uuid
  title                String
  description          String
  requiredInstrument   String
  genres               String[]
  desiredExperience    ExperienceLevel?
  expectedAvailability String?
  locationText         String?
  modality             SearchModality
  visibility           Visibility                @default(PUBLIC)
  status               MemberSearchStatus        @default(OPEN)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  closedAt             DateTime?
  deletedAt            DateTime?
  creator              User                      @relation("MemberSearchCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)
  musicianProfile      MusicianProfile?          @relation(fields: [musicianProfileId], references: [id], onDelete: Cascade)
  bandProject          BandProject?              @relation(fields: [bandProjectId], references: [id], onDelete: Cascade)
  applications         MemberSearchApplication[]

  @@index([status, visibility, updatedAt])
  @@index([creatorUserId])
  @@index([musicianProfileId])
  @@index([bandProjectId])
  @@index([requiredInstrument])
  @@index([genres], type: Gin)
  @@index([deletedAt])
}

model MemberSearchApplication {
  id                String                        @id @default(uuid()) @db.Uuid
  searchId          String                        @db.Uuid
  musicianProfileId String                        @db.Uuid
  message           String?
  status            MemberSearchApplicationStatus @default(PENDING)
  reviewedAt        DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  deletedAt         DateTime?
  search            MemberSearch                  @relation(fields: [searchId], references: [id], onDelete: Cascade)
  musicianProfile   MusicianProfile               @relation(fields: [musicianProfileId], references: [id], onDelete: Cascade)

  @@unique([searchId, musicianProfileId])
  @@index([musicianProfileId, status])
  @@index([searchId, status])
  @@index([deletedAt])
}

model MusicianRecommendationDecision {
  id                 String                 @id @default(uuid()) @db.Uuid
  userId             String                 @db.Uuid
  musicianProfileId  String                 @db.Uuid
  bandProjectId      String?                @db.Uuid
  contextKey         String
  decision           RecommendationDecision
  compatibilityScore Int?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  musicianProfile    MusicianProfile        @relation(fields: [musicianProfileId], references: [id], onDelete: Cascade)
  bandProject        BandProject?           @relation(fields: [bandProjectId], references: [id], onDelete: Cascade)

  @@unique([userId, musicianProfileId, contextKey])
  @@index([userId, contextKey, decision])
  @@index([bandProjectId])
}

model ContactIntent {
  id                String              @id @default(uuid()) @db.Uuid
  requesterUserId   String              @db.Uuid
  targetUserId      String              @db.Uuid
  targetProfileType ContactTargetType
  targetProfileId   String              @db.Uuid
  sourceType        ContactIntentSource
  sourceEntityId    String?             @db.Uuid
  message           String?
  status            ContactIntentStatus @default(PENDING)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  requester         User                @relation("ContactIntentRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  targetUser        User                @relation("ContactIntentTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([requesterUserId, status])
  @@index([targetUserId, status])
  @@index([targetProfileType, targetProfileId])
  @@index([sourceType, sourceEntityId])
}

model Event {
  id                String             @id @default(uuid()) @db.Uuid
  organizerUserId   String             @db.Uuid
  venueId           String?            @db.Uuid
  locationId        String?            @db.Uuid
  title             String
  description       String?
  startsAt          DateTime
  endsAt            DateTime?
  addressVisibility Visibility         @default(PUBLIC)
  visibility        Visibility         @default(PUBLIC)
  status            EventStatus        @default(DRAFT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  organizer         User               @relation("EventOrganizer", fields: [organizerUserId], references: [id], onDelete: Restrict)
  venue             VenueProfile?      @relation(fields: [venueId], references: [id], onDelete: SetNull)
  location          Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  participants      EventParticipant[]
  calls             Call[]
  conversations     ChatConversation[]

  @@index([startsAt, status])
  @@index([organizerUserId])
  @@index([venueId])
  @@index([locationId])
  @@index([deletedAt])
}

model EventParticipant {
  id                  String               @id @default(uuid()) @db.Uuid
  eventId             String               @db.Uuid
  userId              String?              @db.Uuid
  bandProjectId       String?              @db.Uuid
  venueProfileId      String?              @db.Uuid
  providerProfileId   String?              @db.Uuid
  sourceApplicationId String?              @unique @db.Uuid
  role                EventParticipantRole
  status              ParticipationStatus  @default(INVITED)
  confirmedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  event               Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  bandProject         BandProject?         @relation(fields: [bandProjectId], references: [id], onDelete: Cascade)
  venueProfile        VenueProfile?        @relation(fields: [venueProfileId], references: [id], onDelete: Cascade)
  providerProfile     ProviderProfile?     @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  sourceApplication   Application?         @relation(fields: [sourceApplicationId], references: [id], onDelete: SetNull)
  ratings             Rating[]

  @@index([eventId, status])
  @@index([userId])
  @@index([bandProjectId])
  @@index([venueProfileId])
  @@index([providerProfileId])
}

model Call {
  id                    String             @id @default(uuid()) @db.Uuid
  creatorUserId         String             @db.Uuid
  musicianProfileId     String?            @db.Uuid
  bandProjectId         String?            @db.Uuid
  venueProfileId        String?            @db.Uuid
  eventId               String?            @db.Uuid
  organizerType         CallOrganizerType
  type                  CallType
  title                 String
  description           String
  eventName             String?
  proposedDateTime      DateTime
  closesAt              DateTime?
  locationText          String?
  genres                String[]
  preferredStyles       String[]
  maxSelectedApplicants Int                @default(1)
  offeredConditions     String?
  estimatedPayment      Decimal?           @db.Decimal(12, 2)
  currency              String?            @db.Char(3)
  technicalRequirements String?
  visibility            Visibility         @default(PUBLIC)
  status                CallStatus         @default(OPEN)
  closedAt              DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  deletedAt             DateTime?
  creator               User               @relation("CallCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)
  musicianProfile       MusicianProfile?   @relation(fields: [musicianProfileId], references: [id], onDelete: SetNull)
  bandProject           BandProject?       @relation(fields: [bandProjectId], references: [id], onDelete: SetNull)
  venueProfile          VenueProfile?      @relation(fields: [venueProfileId], references: [id], onDelete: SetNull)
  event                 Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  applications          Application[]
  confirmations         CallConfirmation[]
  statusHistory         CallStatusHistory[]
  conversations         ChatConversation[]

  @@index([status, visibility, proposedDateTime])
  @@index([type, status])
  @@index([creatorUserId])
  @@index([musicianProfileId])
  @@index([bandProjectId])
  @@index([venueProfileId])
  @@index([eventId])
  @@index([deletedAt])
}

model Application {
  id                String               @id @default(uuid()) @db.Uuid
  callId            String               @db.Uuid
  submittedByUserId String               @db.Uuid
  applicantType     CallApplicantType
  musicianProfileId String?              @db.Uuid
  bandProjectId     String?              @db.Uuid
  message           String?
  technicalNeeds    String?
  requestedPayment  Decimal?             @db.Decimal(12, 2)
  currency          String?              @db.Char(3)
  status            ApplicationStatus    @default(PENDING)
  reviewedAt        DateTime?
  preselectedAt     DateTime?
  selectedAt        DateTime?
  rejectedAt        DateTime?
  cancelledAt       DateTime?
  withdrawnAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  call              Call                 @relation(fields: [callId], references: [id], onDelete: Cascade)
  submittedBy       User                 @relation("ApplicationSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  musicianProfile   MusicianProfile?     @relation(fields: [musicianProfileId], references: [id], onDelete: Cascade)
  bandProject       BandProject?         @relation(fields: [bandProjectId], references: [id], onDelete: Cascade)
  confirmation      CallConfirmation?
  eventParticipant  EventParticipant?
  ratings           Rating[]

  @@unique([callId, musicianProfileId])
  @@unique([callId, bandProjectId])
  @@index([callId, status])
  @@index([submittedByUserId])
  @@index([musicianProfileId])
  @@index([bandProjectId])
  @@index([deletedAt])
}

model CallConfirmation {
  id              String                 @id @default(uuid()) @db.Uuid
  callId          String                 @db.Uuid
  applicationId   String                 @unique @db.Uuid
  confirmerUserId String                 @db.Uuid
  status          CallConfirmationStatus @default(PENDING_CONFIRMATION)
  confirmedAt     DateTime?
  declinedAt      DateTime?
  declineReason   String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  call            Call                   @relation(fields: [callId], references: [id], onDelete: Cascade)
  application     Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  confirmer       User                   @relation(fields: [confirmerUserId], references: [id], onDelete: Restrict)

  @@index([callId, status])
  @@index([confirmerUserId, status])
}

model CallStatusHistory {
  id              String      @id @default(uuid()) @db.Uuid
  callId          String      @db.Uuid
  previousStatus  CallStatus?
  newStatus       CallStatus
  changedByUserId String      @db.Uuid
  reason          String?
  createdAt       DateTime    @default(now())
  call            Call        @relation(fields: [callId], references: [id], onDelete: Cascade)
  changedBy       User        @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([callId, createdAt])
  @@index([changedByUserId])
}

model Rehearsal {
  id                String                 @id @default(uuid()) @db.Uuid
  organizerUserId   String                 @db.Uuid
  bandProjectId     String?                @db.Uuid
  venueProfileId    String?                @db.Uuid
  locationId        String?                @db.Uuid
  title             String
  notes             String?
  startsAt          DateTime
  endsAt            DateTime?
  addressVisibility Visibility             @default(PRIVATE)
  visibility        Visibility             @default(PRIVATE)
  status            RehearsalStatus        @default(SCHEDULED)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?
  organizer         User                   @relation("RehearsalOrganizer", fields: [organizerUserId], references: [id], onDelete: Restrict)
  bandProject       BandProject?           @relation(fields: [bandProjectId], references: [id], onDelete: SetNull)
  venueProfile      VenueProfile?          @relation(fields: [venueProfileId], references: [id], onDelete: SetNull)
  location          Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  participants      RehearsalParticipant[]

  @@index([startsAt, status])
  @@index([organizerUserId])
  @@index([bandProjectId])
  @@index([venueProfileId])
  @@index([locationId])
  @@index([deletedAt])
}

model RehearsalParticipant {
  id          String                     @id @default(uuid()) @db.Uuid
  rehearsalId String                     @db.Uuid
  userId      String                     @db.Uuid
  status      RehearsalParticipantStatus @default(INVITED)
  respondedAt DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  rehearsal   Rehearsal                  @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings     Rating[]

  @@unique([rehearsalId, userId])
  @@index([userId, status])
}

model ChatConversation {
  id                String             @id @default(uuid()) @db.Uuid
  createdByUserId   String             @db.Uuid
  bandProjectId     String?            @db.Uuid
  eventId           String?            @db.Uuid
  callId            String?            @db.Uuid
  marketplacePostId String?            @db.Uuid
  type              ConversationType
  title             String?
  status            ConversationStatus @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  createdBy         User               @relation("ConversationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  bandProject       BandProject?       @relation(fields: [bandProjectId], references: [id], onDelete: Cascade)
  event             Event?             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  call              Call?              @relation(fields: [callId], references: [id], onDelete: Cascade)
  marketplacePost   MarketplacePost?   @relation(fields: [marketplacePostId], references: [id], onDelete: Cascade)
  participants      ChatParticipant[]
  messages          ChatMessage[]

  @@index([createdByUserId])
  @@index([bandProjectId])
  @@index([eventId])
  @@index([callId])
  @@index([marketplacePostId])
  @@index([type, status])
  @@index([deletedAt])
}

model ChatParticipant {
  id                String           @id @default(uuid()) @db.Uuid
  conversationId    String           @db.Uuid
  userId            String           @db.Uuid
  lastReadMessageId String?          @db.Uuid
  joinedAt          DateTime         @default(now())
  leftAt            DateTime?
  lastReadAt        DateTime?
  conversation      ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadMessage   ChatMessage?     @relation("ParticipantLastReadMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([lastReadMessageId])
}

model ChatMessage {
  id               String                  @id @default(uuid()) @db.Uuid
  conversationId   String                  @db.Uuid
  senderUserId     String                  @db.Uuid
  replyToMessageId String?                 @db.Uuid
  body             String?
  sentAt           DateTime                @default(now())
  editedAt         DateTime?
  deletedAt        DateTime?
  conversation     ChatConversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User                    @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  replyToMessage   ChatMessage?            @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          ChatMessage[]           @relation("MessageReplies")
  attachments      ChatMessageAttachment[]
  lastReadBy       ChatParticipant[]       @relation("ParticipantLastReadMessage")
  reports          Report[]

  @@index([conversationId, sentAt])
  @@index([senderUserId])
  @@index([replyToMessageId])
}

model ChatMessageAttachment {
  id         String      @id @default(uuid()) @db.Uuid
  messageId  String      @db.Uuid
  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime    @default(now())
  message    ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model MarketplacePost {
  id            String                 @id @default(uuid()) @db.Uuid
  sellerUserId  String                 @db.Uuid
  locationId    String?                @db.Uuid
  title         String
  description   String
  type          MarketplacePostType
  status        MarketplaceStatus      @default(PUBLISHED)
  price         Decimal?               @db.Decimal(12, 2)
  currency      String?                @db.Char(3)
  visibility    Visibility             @default(PUBLIC)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  deletedAt     DateTime?
  seller        User                   @relation(fields: [sellerUserId], references: [id], onDelete: Restrict)
  location      Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  operations    MarketplaceOperation[]
  conversations ChatConversation[]
  reports       Report[]

  @@index([status, type])
  @@index([sellerUserId])
  @@index([locationId])
  @@index([deletedAt])
}

model MarketplaceOperation {
  id           String                     @id @default(uuid()) @db.Uuid
  postId       String                     @db.Uuid
  buyerUserId  String                     @db.Uuid
  sellerUserId String                     @db.Uuid
  type         MarketplaceOperationType
  status       MarketplaceOperationStatus @default(PENDING)
  amount       Decimal?                   @db.Decimal(12, 2)
  currency     String?                    @db.Char(3)
  startsAt     DateTime?
  endsAt       DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  post         MarketplacePost            @relation(fields: [postId], references: [id], onDelete: Restrict)
  buyer        User                       @relation("MarketplaceBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  seller       User                       @relation("MarketplaceSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  ratings      Rating[]

  @@index([postId, status])
  @@index([buyerUserId])
  @@index([sellerUserId])
}

model Rating {
  id                     String                @id @default(uuid()) @db.Uuid
  authorUserId           String                @db.Uuid
  musicianProfileId      String?               @db.Uuid
  bandProjectId          String?               @db.Uuid
  venueProfileId         String?               @db.Uuid
  providerProfileId      String?               @db.Uuid
  applicationId          String?               @db.Uuid
  eventParticipantId     String?               @db.Uuid
  rehearsalParticipantId String?               @db.Uuid
  marketplaceOperationId String?               @db.Uuid
  score                  Int
  comment                String?
  visibility             Visibility            @default(PUBLIC)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deletedAt              DateTime?
  author                 User                  @relation("RatingAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  musicianProfile        MusicianProfile?      @relation(fields: [musicianProfileId], references: [id], onDelete: Cascade)
  bandProject            BandProject?          @relation(fields: [bandProjectId], references: [id], onDelete: Cascade)
  venueProfile           VenueProfile?         @relation(fields: [venueProfileId], references: [id], onDelete: Cascade)
  providerProfile        ProviderProfile?      @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  application            Application?          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  eventParticipant       EventParticipant?     @relation(fields: [eventParticipantId], references: [id], onDelete: Cascade)
  rehearsalParticipant   RehearsalParticipant? @relation(fields: [rehearsalParticipantId], references: [id], onDelete: Cascade)
  marketplaceOperation   MarketplaceOperation? @relation(fields: [marketplaceOperationId], references: [id], onDelete: Cascade)

  @@index([authorUserId])
  @@index([musicianProfileId])
  @@index([bandProjectId])
  @@index([venueProfileId])
  @@index([providerProfileId])
  @@index([applicationId])
  @@index([eventParticipantId])
  @@index([rehearsalParticipantId])
  @@index([marketplaceOperationId])
  @@index([deletedAt])
}

model Report {
  id                String           @id @default(uuid()) @db.Uuid
  reporterUserId    String           @db.Uuid
  assignedToUserId  String?          @db.Uuid
  reportedUserId    String?          @db.Uuid
  chatMessageId     String?          @db.Uuid
  marketplacePostId String?          @db.Uuid
  type              ReportType
  status            ReportStatus     @default(OPEN)
  description       String?
  resolutionNotes   String?
  resolvedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  reporter          User             @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  assignedTo        User?            @relation("ReportAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  reportedUser      User?            @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  chatMessage       ChatMessage?     @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  marketplacePost   MarketplacePost? @relation(fields: [marketplacePostId], references: [id], onDelete: Cascade)

  @@index([status, type])
  @@index([reporterUserId])
  @@index([assignedToUserId])
  @@index([reportedUserId])
  @@index([chatMessageId])
  @@index([marketplacePostId])
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @db.Uuid
  action      AuditAction
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  actor       User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}
