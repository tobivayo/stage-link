generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserRoleStatus {
  ACTIVE
  PENDING_PROFILE
  INACTIVE
}

enum Visibility {
  PUBLIC
  REGISTERED_ONLY
  PRIVATE
}

enum ProfileStatus {
  DRAFT
  ACTIVE
  HIDDEN
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
}

enum BandStatus {
  ACTIVE
  ON_HOLD
  DISBANDED
}

enum BandMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum BandMemberStatus {
  ACTIVE
  INACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum EventParticipantRole {
  ORGANIZER
  PERFORMER
  VENUE
  PROVIDER
  CREW
  GUEST
}

enum ParticipationStatus {
  INVITED
  CONFIRMED
  DECLINED
  CANCELLED
}

enum CallStatus {
  OPEN
  IN_REVIEW
  CLOSED
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  IN_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum RehearsalStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum RehearsalParticipantStatus {
  INVITED
  CONFIRMED
  DECLINED
  ATTENDED
  ABSENT
}

enum ConversationType {
  DIRECT
  GROUP
  BAND
  EVENT
  CALL
  MARKETPLACE
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  CLOSED
}

enum MarketplacePostType {
  SALE
  RENTAL
  SERVICE
}

enum MarketplaceStatus {
  PUBLISHED
  RESERVED
  SOLD
  CANCELLED
  SUSPENDED
}

enum MarketplaceOperationType {
  PURCHASE
  RENTAL
  SERVICE_BOOKING
}

enum MarketplaceOperationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ReportType {
  SPAM
  ABUSE
  FRAUD
  INAPPROPRIATE_CONTENT
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  REGISTER
  ROLE_ACTIVATE
  ROLE_DEACTIVATE
  PREFERENCES_UPDATE
  STATUS_CHANGE
}

model User {
  id                          String                 @id @default(uuid()) @db.Uuid
  email                       String                 @unique
  passwordHash                String?
  firstName                   String
  lastName                    String
  locationText                String?
  status                      UserStatus             @default(ACTIVE)
  termsAcceptedAt             DateTime?
  emailVerifiedAt             DateTime?
  lastLoginAt                 DateTime?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  deletedAt                   DateTime?
  roles                       UserRole[]
  preferences                 UserPreferences?
  musicianProfile             MusicianProfile?
  venueMemberships            VenueMember[]
  providerMemberships         ProviderMember[]
  ownedBands                  BandProject[]          @relation("BandOwner")
  bandMemberships             BandMember[]
  bandInvitationsSent         BandInvitation[]       @relation("BandInvitationSender")
  bandInvitationsReceived     BandInvitation[]       @relation("BandInvitationRecipient")
  organizedEvents             Event[]                @relation("EventOrganizer")
  eventParticipations         EventParticipant[]
  createdCalls                Call[]                 @relation("CallCreator")
  submittedApplications       Application[]          @relation("ApplicationSubmitter")
  organizedRehearsals         Rehearsal[]            @relation("RehearsalOrganizer")
  rehearsalParticipations     RehearsalParticipant[]
  createdConversations        ChatConversation[]     @relation("ConversationCreator")
  conversationParticipants    ChatParticipant[]
  sentMessages                ChatMessage[]
  marketplacePosts            MarketplacePost[]
  marketplaceOperationsBought MarketplaceOperation[] @relation("MarketplaceBuyer")
  marketplaceOperationsSold   MarketplaceOperation[] @relation("MarketplaceSeller")
  ratingsAuthored             Rating[]               @relation("RatingAuthor")
  reportsFiled                Report[]               @relation("ReportReporter")
  reportsReceived             Report[]               @relation("ReportedUser")
  reportsAssigned             Report[]               @relation("ReportAssignee")
  auditLogs                   AuditLog[]             @relation("AuditActor")

  @@index([status])
  @@index([deletedAt])
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       UserRole[]
}

model UserRole {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  roleId        String         @db.Uuid
  status        UserRoleStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deactivatedAt DateTime?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId, status])
  @@index([roleId])
}

model UserPreferences {
  id                           String     @id @default(uuid()) @db.Uuid
  userId                       String     @unique @db.Uuid
  locale                       String     @default("es-AR")
  timezone                     String     @default("America/Argentina/Buenos_Aires")
  internalNotificationsEnabled Boolean    @default(true)
  pushNotificationsEnabled     Boolean    @default(true)
  emailNotificationsEnabled    Boolean    @default(true)
  defaultVisibility            Visibility @default(REGISTERED_ONLY)
  contactAvailability          Boolean    @default(true)
  createdAt                    DateTime   @default(now())
  updatedAt                    DateTime   @updatedAt
  user                         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MusicianProfile {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @unique @db.Uuid
  stageName    String?
  bio          String?
  city         String?
  countryCode  String?       @db.Char(2)
  instruments  String[]
  genres       String[]
  visibility   Visibility    @default(PUBLIC)
  status       ProfileStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  ratings      Rating[]

  @@index([visibility, status])
  @@index([deletedAt])
}

model VenueProfile {
  id                  String             @id @default(uuid()) @db.Uuid
  locationId          String?            @db.Uuid
  name                String
  description         String?
  capacity            Int?
  addressVisibility   Visibility         @default(PUBLIC)
  visibility          Visibility         @default(PUBLIC)
  status              ProfileStatus      @default(DRAFT)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  location            Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  members             VenueMember[]
  events              Event[]
  calls               Call[]
  rehearsals          Rehearsal[]
  eventParticipations EventParticipant[]
  ratings             Rating[]

  @@index([locationId])
  @@index([visibility, status])
  @@index([deletedAt])
}

model VenueMember {
  id        String                 @id @default(uuid()) @db.Uuid
  venueId   String                 @db.Uuid
  userId    String                 @db.Uuid
  role      OrganizationMemberRole @default(ADMIN)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  venue     VenueProfile           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId])
  @@index([userId])
}

model ProviderProfile {
  id                  String             @id @default(uuid()) @db.Uuid
  locationId          String?            @db.Uuid
  businessName        String
  description         String?
  serviceTags         String[]
  addressVisibility   Visibility         @default(REGISTERED_ONLY)
  visibility          Visibility         @default(PUBLIC)
  status              ProfileStatus      @default(DRAFT)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  location            Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  members             ProviderMember[]
  eventParticipations EventParticipant[]
  ratings             Rating[]

  @@index([locationId])
  @@index([visibility, status])
  @@index([deletedAt])
}

model ProviderMember {
  id         String                 @id @default(uuid()) @db.Uuid
  providerId String                 @db.Uuid
  userId     String                 @db.Uuid
  role       OrganizationMemberRole @default(ADMIN)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  provider   ProviderProfile        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, userId])
  @@index([userId])
}

model Location {
  id               String            @id @default(uuid()) @db.Uuid
  name             String?
  addressLine1     String
  addressLine2     String?
  city             String
  region           String?
  postalCode       String?
  countryCode      String            @db.Char(2)
  latitude         Decimal?          @db.Decimal(9, 6)
  longitude        Decimal?          @db.Decimal(9, 6)
  timezone         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  venues           VenueProfile[]
  providers        ProviderProfile[]
  events           Event[]
  rehearsals       Rehearsal[]
  marketplacePosts MarketplacePost[]

  @@index([city, countryCode])
  @@index([deletedAt])
}

model BandProject {
  id            String             @id @default(uuid()) @db.Uuid
  ownerUserId   String             @db.Uuid
  name          String
  description   String?
  genres        String[]
  city          String?
  countryCode   String?            @db.Char(2)
  visibility    Visibility         @default(PUBLIC)
  status        BandStatus         @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  owner         User               @relation("BandOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members       BandMember[]
  invitations   BandInvitation[]
  events        EventParticipant[]
  calls         Call[]
  applications  Application[]
  rehearsals    Rehearsal[]
  conversations ChatConversation[]
  ratings       Rating[]

  @@index([ownerUserId])
  @@index([visibility, status])
  @@index([deletedAt])
}

model BandMember {
  id         String           @id @default(uuid()) @db.Uuid
  bandId     String           @db.Uuid
  userId     String           @db.Uuid
  role       BandMemberRole   @default(MEMBER)
  status     BandMemberStatus @default(ACTIVE)
  instrument String?
  joinedAt   DateTime         @default(now())
  leftAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  band       BandProject      @relation(fields: [bandId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bandId, userId])
  @@index([userId, status])
}

model BandInvitation {
  id            String           @id @default(uuid()) @db.Uuid
  bandId        String           @db.Uuid
  invitedUserId String           @db.Uuid
  invitedById   String           @db.Uuid
  role          BandMemberRole   @default(MEMBER)
  instrument    String?
  message       String?
  status        InvitationStatus @default(PENDING)
  expiresAt     DateTime?
  respondedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  band          BandProject      @relation(fields: [bandId], references: [id], onDelete: Cascade)
  invitedUser   User             @relation("BandInvitationRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy     User             @relation("BandInvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([bandId, status])
  @@index([invitedUserId, status])
}

model Event {
  id                String             @id @default(uuid()) @db.Uuid
  organizerUserId   String             @db.Uuid
  venueId           String?            @db.Uuid
  locationId        String?            @db.Uuid
  title             String
  description       String?
  startsAt          DateTime
  endsAt            DateTime?
  addressVisibility Visibility         @default(PUBLIC)
  visibility        Visibility         @default(PUBLIC)
  status            EventStatus        @default(DRAFT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  organizer         User               @relation("EventOrganizer", fields: [organizerUserId], references: [id], onDelete: Restrict)
  venue             VenueProfile?      @relation(fields: [venueId], references: [id], onDelete: SetNull)
  location          Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  participants      EventParticipant[]
  calls             Call[]
  conversations     ChatConversation[]

  @@index([startsAt, status])
  @@index([organizerUserId])
  @@index([venueId])
  @@index([locationId])
  @@index([deletedAt])
}

model EventParticipant {
  id                  String               @id @default(uuid()) @db.Uuid
  eventId             String               @db.Uuid
  userId              String?              @db.Uuid
  bandProjectId       String?              @db.Uuid
  venueProfileId      String?              @db.Uuid
  providerProfileId   String?              @db.Uuid
  sourceApplicationId String?              @unique @db.Uuid
  role                EventParticipantRole
  status              ParticipationStatus  @default(INVITED)
  confirmedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  event               Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  bandProject         BandProject?         @relation(fields: [bandProjectId], references: [id], onDelete: Cascade)
  venueProfile        VenueProfile?        @relation(fields: [venueProfileId], references: [id], onDelete: Cascade)
  providerProfile     ProviderProfile?     @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  sourceApplication   Application?         @relation(fields: [sourceApplicationId], references: [id], onDelete: SetNull)
  ratings             Rating[]

  @@index([eventId, status])
  @@index([userId])
  @@index([bandProjectId])
  @@index([venueProfileId])
  @@index([providerProfileId])
}

model Call {
  id             String             @id @default(uuid()) @db.Uuid
  creatorUserId  String             @db.Uuid
  bandProjectId  String?            @db.Uuid
  venueProfileId String?            @db.Uuid
  eventId        String?            @db.Uuid
  title          String
  description    String
  requirements   String?
  closesAt       DateTime?
  visibility     Visibility         @default(PUBLIC)
  status         CallStatus         @default(OPEN)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  creator        User               @relation("CallCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)
  bandProject    BandProject?       @relation(fields: [bandProjectId], references: [id], onDelete: SetNull)
  venueProfile   VenueProfile?      @relation(fields: [venueProfileId], references: [id], onDelete: SetNull)
  event          Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  applications   Application[]
  conversations  ChatConversation[]

  @@index([status, closesAt])
  @@index([creatorUserId])
  @@index([bandProjectId])
  @@index([venueProfileId])
  @@index([eventId])
  @@index([deletedAt])
}

model Application {
  id                String            @id @default(uuid()) @db.Uuid
  callId            String            @db.Uuid
  submittedByUserId String            @db.Uuid
  musicianProfileId String?           @db.Uuid
  bandProjectId     String?           @db.Uuid
  message           String?
  status            ApplicationStatus @default(PENDING)
  reviewedAt        DateTime?
  selectedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  call              Call              @relation(fields: [callId], references: [id], onDelete: Cascade)
  submittedBy       User              @relation("ApplicationSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  musicianProfile   MusicianProfile?  @relation(fields: [musicianProfileId], references: [id], onDelete: Cascade)
  bandProject       BandProject?      @relation(fields: [bandProjectId], references: [id], onDelete: Cascade)
  eventParticipant  EventParticipant?
  ratings           Rating[]

  @@index([callId, status])
  @@index([submittedByUserId])
  @@index([musicianProfileId])
  @@index([bandProjectId])
  @@index([deletedAt])
}

model Rehearsal {
  id                String                 @id @default(uuid()) @db.Uuid
  organizerUserId   String                 @db.Uuid
  bandProjectId     String?                @db.Uuid
  venueProfileId    String?                @db.Uuid
  locationId        String?                @db.Uuid
  title             String
  notes             String?
  startsAt          DateTime
  endsAt            DateTime?
  addressVisibility Visibility             @default(PRIVATE)
  visibility        Visibility             @default(PRIVATE)
  status            RehearsalStatus        @default(SCHEDULED)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?
  organizer         User                   @relation("RehearsalOrganizer", fields: [organizerUserId], references: [id], onDelete: Restrict)
  bandProject       BandProject?           @relation(fields: [bandProjectId], references: [id], onDelete: SetNull)
  venueProfile      VenueProfile?          @relation(fields: [venueProfileId], references: [id], onDelete: SetNull)
  location          Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  participants      RehearsalParticipant[]

  @@index([startsAt, status])
  @@index([organizerUserId])
  @@index([bandProjectId])
  @@index([venueProfileId])
  @@index([locationId])
  @@index([deletedAt])
}

model RehearsalParticipant {
  id          String                     @id @default(uuid()) @db.Uuid
  rehearsalId String                     @db.Uuid
  userId      String                     @db.Uuid
  status      RehearsalParticipantStatus @default(INVITED)
  respondedAt DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  rehearsal   Rehearsal                  @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings     Rating[]

  @@unique([rehearsalId, userId])
  @@index([userId, status])
}

model ChatConversation {
  id                String             @id @default(uuid()) @db.Uuid
  createdByUserId   String             @db.Uuid
  bandProjectId     String?            @db.Uuid
  eventId           String?            @db.Uuid
  callId            String?            @db.Uuid
  marketplacePostId String?            @db.Uuid
  type              ConversationType
  title             String?
  status            ConversationStatus @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  createdBy         User               @relation("ConversationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  bandProject       BandProject?       @relation(fields: [bandProjectId], references: [id], onDelete: Cascade)
  event             Event?             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  call              Call?              @relation(fields: [callId], references: [id], onDelete: Cascade)
  marketplacePost   MarketplacePost?   @relation(fields: [marketplacePostId], references: [id], onDelete: Cascade)
  participants      ChatParticipant[]
  messages          ChatMessage[]

  @@index([createdByUserId])
  @@index([bandProjectId])
  @@index([eventId])
  @@index([callId])
  @@index([marketplacePostId])
  @@index([type, status])
  @@index([deletedAt])
}

model ChatParticipant {
  id                String           @id @default(uuid()) @db.Uuid
  conversationId    String           @db.Uuid
  userId            String           @db.Uuid
  lastReadMessageId String?          @db.Uuid
  joinedAt          DateTime         @default(now())
  leftAt            DateTime?
  lastReadAt        DateTime?
  conversation      ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadMessage   ChatMessage?     @relation("ParticipantLastReadMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([lastReadMessageId])
}

model ChatMessage {
  id               String                  @id @default(uuid()) @db.Uuid
  conversationId   String                  @db.Uuid
  senderUserId     String                  @db.Uuid
  replyToMessageId String?                 @db.Uuid
  body             String?
  sentAt           DateTime                @default(now())
  editedAt         DateTime?
  deletedAt        DateTime?
  conversation     ChatConversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User                    @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  replyToMessage   ChatMessage?            @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          ChatMessage[]           @relation("MessageReplies")
  attachments      ChatMessageAttachment[]
  lastReadBy       ChatParticipant[]       @relation("ParticipantLastReadMessage")
  reports          Report[]

  @@index([conversationId, sentAt])
  @@index([senderUserId])
  @@index([replyToMessageId])
}

model ChatMessageAttachment {
  id         String      @id @default(uuid()) @db.Uuid
  messageId  String      @db.Uuid
  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime    @default(now())
  message    ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model MarketplacePost {
  id            String                 @id @default(uuid()) @db.Uuid
  sellerUserId  String                 @db.Uuid
  locationId    String?                @db.Uuid
  title         String
  description   String
  type          MarketplacePostType
  status        MarketplaceStatus      @default(PUBLISHED)
  price         Decimal?               @db.Decimal(12, 2)
  currency      String?                @db.Char(3)
  visibility    Visibility             @default(PUBLIC)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  deletedAt     DateTime?
  seller        User                   @relation(fields: [sellerUserId], references: [id], onDelete: Restrict)
  location      Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  operations    MarketplaceOperation[]
  conversations ChatConversation[]
  reports       Report[]

  @@index([status, type])
  @@index([sellerUserId])
  @@index([locationId])
  @@index([deletedAt])
}

model MarketplaceOperation {
  id           String                     @id @default(uuid()) @db.Uuid
  postId       String                     @db.Uuid
  buyerUserId  String                     @db.Uuid
  sellerUserId String                     @db.Uuid
  type         MarketplaceOperationType
  status       MarketplaceOperationStatus @default(PENDING)
  amount       Decimal?                   @db.Decimal(12, 2)
  currency     String?                    @db.Char(3)
  startsAt     DateTime?
  endsAt       DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  post         MarketplacePost            @relation(fields: [postId], references: [id], onDelete: Restrict)
  buyer        User                       @relation("MarketplaceBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  seller       User                       @relation("MarketplaceSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  ratings      Rating[]

  @@index([postId, status])
  @@index([buyerUserId])
  @@index([sellerUserId])
}

model Rating {
  id                     String                @id @default(uuid()) @db.Uuid
  authorUserId           String                @db.Uuid
  musicianProfileId      String?               @db.Uuid
  bandProjectId          String?               @db.Uuid
  venueProfileId         String?               @db.Uuid
  providerProfileId      String?               @db.Uuid
  applicationId          String?               @db.Uuid
  eventParticipantId     String?               @db.Uuid
  rehearsalParticipantId String?               @db.Uuid
  marketplaceOperationId String?               @db.Uuid
  score                  Int
  comment                String?
  visibility             Visibility            @default(PUBLIC)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deletedAt              DateTime?
  author                 User                  @relation("RatingAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  musicianProfile        MusicianProfile?      @relation(fields: [musicianProfileId], references: [id], onDelete: Cascade)
  bandProject            BandProject?          @relation(fields: [bandProjectId], references: [id], onDelete: Cascade)
  venueProfile           VenueProfile?         @relation(fields: [venueProfileId], references: [id], onDelete: Cascade)
  providerProfile        ProviderProfile?      @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  application            Application?          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  eventParticipant       EventParticipant?     @relation(fields: [eventParticipantId], references: [id], onDelete: Cascade)
  rehearsalParticipant   RehearsalParticipant? @relation(fields: [rehearsalParticipantId], references: [id], onDelete: Cascade)
  marketplaceOperation   MarketplaceOperation? @relation(fields: [marketplaceOperationId], references: [id], onDelete: Cascade)

  @@index([authorUserId])
  @@index([musicianProfileId])
  @@index([bandProjectId])
  @@index([venueProfileId])
  @@index([providerProfileId])
  @@index([applicationId])
  @@index([eventParticipantId])
  @@index([rehearsalParticipantId])
  @@index([marketplaceOperationId])
  @@index([deletedAt])
}

model Report {
  id                String           @id @default(uuid()) @db.Uuid
  reporterUserId    String           @db.Uuid
  assignedToUserId  String?          @db.Uuid
  reportedUserId    String?          @db.Uuid
  chatMessageId     String?          @db.Uuid
  marketplacePostId String?          @db.Uuid
  type              ReportType
  status            ReportStatus     @default(OPEN)
  description       String?
  resolutionNotes   String?
  resolvedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  reporter          User             @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  assignedTo        User?            @relation("ReportAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  reportedUser      User?            @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  chatMessage       ChatMessage?     @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  marketplacePost   MarketplacePost? @relation(fields: [marketplacePostId], references: [id], onDelete: Cascade)

  @@index([status, type])
  @@index([reporterUserId])
  @@index([assignedToUserId])
  @@index([reportedUserId])
  @@index([chatMessageId])
  @@index([marketplacePostId])
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @db.Uuid
  action      AuditAction
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  actor       User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}
